<div>
    {{#if title.show}}
    <header class="journal-page-header">
        <h{{ title.level }}>{{ name }}</h{{ title.level }}>
    </header>
    {{/if}}

    <section class="journal-page-content clueboard-page-content">
        <div class="clueboard-doc">
            {{#if img}}<img class="clueboard-doc-image" src="{{ img }}" alt="{{ name }}">{{/if}}
            <div class="clueboard-doc-text">{{{ html }}}</div>
            {{#if revision}}<p class="clueboard-doc-revision">{{ revision }}</p>{{/if}}
        </div>

        <div class="clueboard-stamp">
            <div class="clueboard-stamp-cell">
                <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.page.foundIn" }}</span>
                <span>{{ stamp.foundIn }}</span>
                {{#if stamp.calendarDate}}<small>{{ stamp.calendarDate }}</small>{{/if}}
                {{#if stamp.realDate}}<small>{{ stamp.realDate }}</small>{{/if}}
            </div>
            <div class="clueboard-stamp-cell">
                <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.page.readBy" }}</span>
                <span class="clueboard-chips">
                    {{#each stamp.readers}}<span class="clueboard-chip{{#if me}} me{{/if}}">{{ name }}</span>{{/each}}
                </span>
            </div>
            <div class="clueboard-stamp-cell">
                <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.page.heldBy" }}</span>
                <span class="{{#if stamp.left}}clueboard-left{{/if}}">{{ stamp.holder }}</span>
            </div>
            {{#if stamp.notes}}
            <div class="clueboard-stamp-cell clueboard-stamp-notes">
                <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.page.notesLabel" }}</span>
                <span class="clueboard-notes">{{ stamp.notes }}</span>
            </div>
            {{/if}}
        </div>
    </section>
</div>
