<div class="clueboard-mysteries-body{{#if isGM}} clueboard-gm{{else}} clueboard-player{{/if}}">
<header class="clueboard-bar">
    <label class="clueboard-search">
        <i class="fa-solid fa-magnifying-glass" inert></i>
        <input type="search" name="search" autocomplete="off" value="{{ query }}"
               placeholder="{{ localize "fvtt-mod-clueboard.mysteries.search" }}"
               aria-label="{{ localize "fvtt-mod-clueboard.mysteries.search" }}">
    </label>
</header>

{{#if isGM}}
<div class="clueboard-gm-strip">
    <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.mysteries.uncollected" }}</span>
    {{#each uncollected}}
    <span class="clueboard-strip-item">
        <img src="{{ img }}" alt="">
        <span class="clueboard-strip-name" data-action="openItem" data-uuid="{{ uuid }}">{{ name }}</span>
        <button type="button" class="clueboard-btn pri clueboard-strip-collect" data-action="collect" data-uuid="{{ uuid }}">{{ localize "fvtt-mod-clueboard.mysteries.collect" }}</button>
    </span>
    {{else}}
    <span class="clueboard-strip-none">{{ localize "fvtt-mod-clueboard.mysteries.allCollected" }}</span>
    {{/each}}
    <span class="clueboard-strip-hint">{{ localize "fvtt-mod-clueboard.mysteries.dropHint" }}</span>
</div>
{{/if}}

<div class="clueboard-entries">
    {{#if none}}
    <p class="clueboard-empty">{{ localize "fvtt-mod-clueboard.mysteries.noParty" }}</p>
    {{/if}}

    {{#each sections}}
    <section class="clueboard-section" data-group="{{ id }}" {{#if thread}}data-thread="{{ thread.id }}"{{/if}}>

        {{!-- The rail: the clue views, then the party's mysteries. A card dropped on a mystery pins it there and the view stays put. --}}
        <nav class="clueboard-rail" aria-label="{{ localize "fvtt-mod-clueboard.mysteries.title" }}">
            {{#if ../several}}<h4 class="clueboard-rail-party">{{ name }}</h4>{{/if}}
            <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.mysteries.cluesLabel" }}</span>
            {{#each views}}
            <button type="button" class="clueboard-tab clueboard-rail-row clueboard-rail-view{{#if active}} active{{/if}}" data-action="showTab" data-tab="{{ id }}" aria-current="{{#if active}}true{{else}}false{{/if}}">
                <span class="clueboard-rail-name">{{ name }}</span>
                <small class="clueboard-tab-count">{{ count }}</small>
            </button>
            {{/each}}

            <span class="clueboard-key" data-tooltip="{{ localize "fvtt-mod-clueboard.mysteries.mysteriesHint" }}">{{ localize "fvtt-mod-clueboard.mysteries.mysteriesLabel" }}</span>
            {{#each mysteries}}
            <button type="button" class="clueboard-tab clueboard-rail-row clueboard-thread-{{ colour }}{{#if active}} active{{/if}}{{#if answered}} answered{{/if}}"
                    data-action="showTab" data-tab="{{ id }}" data-droppable="true" aria-current="{{#if active}}true{{else}}false{{/if}}">
                <span class="clueboard-dot"></span>
                <span class="clueboard-rail-name">{{ name }}</span>
                {{#if answered}}
                <i class="clueboard-rail-status solved fa-solid fa-circle-check" data-tooltip aria-label="{{ localize "fvtt-mod-clueboard.mysteries.threadAnswered" }}"></i>
                {{else}}
                <i class="clueboard-rail-status fa-regular fa-circle" data-tooltip aria-label="{{ localize "fvtt-mod-clueboard.mysteries.threadOpen" }}"></i>
                {{/if}}
                <small class="clueboard-tab-count">{{ count }}</small>
            </button>
            {{else}}
            <span class="clueboard-rail-none">{{ localize "fvtt-mod-clueboard.mysteries.noMysteries" }}</span>
            {{/each}}
            {{#if mayOrganise}}
            <button type="button" class="clueboard-tab clueboard-tab-new" data-action="newThread">
                <i class="fa-solid fa-plus" inert></i> {{ localize "fvtt-mod-clueboard.mysteries.newThread" }}
            </button>
            {{/if}}
        </nav>

        <div class="clueboard-main">
            <div class="clueboard-section-head{{#if thread}} clueboard-thread-{{ thread.colour }}{{/if}}">
                <h2>{{#if thread}}<span class="clueboard-dot"></span>{{/if}}<span dir="auto">{{ heading }}</span></h2>
                <span class="clueboard-count">{{ total }}{{#if unread}} · {{ unreadText }}{{/if}}</span>
                {{#if thread}}{{#if mayOrganise}}
                <span class="clueboard-thread-tools">
                    <button type="button" class="clueboard-tog clueboard-thread-status{{#if thread.answered}} on answered{{/if}}" data-action="toggleStatus" data-thread="{{ thread.id }}"
                            aria-pressed="{{#if thread.answered}}true{{else}}false{{/if}}">
                        <i class="fa-{{#if thread.answered}}solid fa-circle-check{{else}}regular fa-circle{{/if}}" inert></i>
                        {{#if thread.answered}}{{ localize "fvtt-mod-clueboard.mysteries.threadAnswered" }}{{else}}{{ localize "fvtt-mod-clueboard.mysteries.threadOpen" }}{{/if}}
                    </button>
                    <button type="button" class="clueboard-icon" data-action="editThread" data-thread="{{ thread.id }}"
                            data-tooltip aria-label="{{ localize "fvtt-mod-clueboard.mysteries.threadEdit" }}"><i class="fa-solid fa-pen" inert></i></button>
                    <button type="button" class="clueboard-icon" data-action="deleteThread" data-thread="{{ thread.id }}"
                            data-tooltip aria-label="{{ localize "fvtt-mod-clueboard.mysteries.threadDelete" }}"><i class="fa-solid fa-trash" inert></i></button>
                </span>
                {{/if}}{{/if}}
                <button type="button" class="clueboard-icon clueboard-export" data-action="export"
                        data-tooltip aria-label="{{ localize "fvtt-mod-clueboard.mysteries.export" }}"><i class="fa-solid fa-file-export" inert></i></button>
            </div>

            {{#if thread}}
            <div class="clueboard-thread-head clueboard-thread-{{ thread.colour }}">
                {{#if thread.question}}<span class="clueboard-thread-question" dir="auto">{{ thread.question }}</span>{{/if}}
                <div class="clueboard-thread-stand">
                    <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.mysteries.threadStand" }}</span>
                    {{#if mayOrganise}}
                    <textarea name="stand" placeholder="{{ localize "fvtt-mod-clueboard.mysteries.threadStandHint" }}">{{ thread.stand }}</textarea>
                    {{else}}
                    <span class="clueboard-thread-stand-text">{{#if thread.stand}}{{ thread.stand }}{{else}}—{{/if}}</span>
                    {{/if}}
                </div>
            </div>
            {{/if}}

            {{#unless entries.length}}
            <p class="clueboard-empty">
                {{#if thread}}{{ localize "fvtt-mod-clueboard.mysteries.threadEmpty" }}
                {{else if (eq active "unsorted")}}{{ localize "fvtt-mod-clueboard.mysteries.unsortedEmpty" }}
                {{else}}{{ localize "fvtt-mod-clueboard.mysteries.empty" }}{{/if}}
            </p>
            {{/unless}}

            <div class="clueboard-cards">
            {{#each entries}}
            <article class="clueboard-card{{#if unread}} unread{{/if}}" data-action="open" data-group="{{ group }}" data-id="{{ id }}" data-search="{{ search }}" role="button" tabindex="0" aria-label="{{ name }}">
                <span class="clueboard-thumb">
                    {{#if picture}}<img src="{{ picture }}" alt="" loading="lazy" draggable="false">
                    {{else}}<span class="clueboard-excerpt"><i class="fa-solid {{ kindIcon }}" inert></i><span>{{ excerpt }}</span></span>{{/if}}
                    {{!-- New is the player's: the DM's "unread by anyone" is the eye's 0, or a board of ten would all be gold. --}}
                    {{#if unread}}{{#unless ../../isGM}}<span class="clueboard-new">{{ localize "fvtt-mod-clueboard.mysteries.new" }}</span>{{/unless}}{{/if}}
                    <span class="clueboard-badge" data-tooltip="{{ kind }}"><i class="fa-solid {{ kindIcon }}" inert></i><span class="clueboard-badge-text"> {{ kind }}</span></span>
                    {{#if threads.length}}<span class="clueboard-card-threads">
                        {{#each threads}}<span class="clueboard-dot clueboard-thread-{{ colour }}" data-tooltip="{{ name }}" aria-label="{{ name }}"></span>{{/each}}
                    </span>{{/if}}
                </span>
                <span class="clueboard-cb">
                    <span class="clueboard-card-title" dir="auto">{{ name }}</span>
                    <span class="clueboard-sub">
                        <span class="clueboard-where">{{#if where}}{{ where }}{{else}}{{ kind }}{{/if}}</span>
                        {{#if notes}}<i class="fa-solid fa-pen clueboard-has-note" data-tooltip="{{ localize "fvtt-mod-clueboard.mysteries.hasNote" }}"></i>{{/if}}
                        <span class="clueboard-reads{{#unless readers.length}} none{{/unless}}" data-tooltip="{{ readText }}"><i class="fa-solid fa-eye" inert></i> {{ readers.length }}</span>
                    </span>
                </span>
                <span class="clueboard-acts">
                    {{#if ../thread}}{{#if ../mayOrganise}}
                    <button type="button" class="clueboard-card-unpin" data-action="unpin" data-id="{{ id }}" data-thread="{{ ../thread.id }}"
                            data-tooltip aria-label="{{ localize "fvtt-mod-clueboard.mysteries.unpin" }}"><i class="fa-solid fa-thumbtack-slash" inert></i></button>
                    {{/if}}{{/if}}
                    {{#if ../../isGM}}
                    <button type="button" class="clueboard-card-remove" data-action="remove" data-group="{{ group }}" data-id="{{ id }}"
                            data-tooltip aria-label="{{ localize "fvtt-mod-clueboard.mysteries.remove" }}"><i class="fa-solid fa-xmark" inert></i></button>
                    {{/if}}
                </span>
            </article>
            {{/each}}
            </div>
        </div>
    </section>
    {{/each}}
</div>
</div>
