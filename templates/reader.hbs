<div class="clueboard-reader-body">
{{#if gone}}
<p class="clueboard-empty">{{ localize "fvtt-mod-clueboard.read.entryGone" }}</p>
{{else}}
<div class="clueboard-doc">
    {{#if img}}
    <img class="clueboard-doc-image" src="{{ img }}" alt="{{ name }}">
    {{/if}}
    <h2 class="clueboard-doc-title">{{ name }}</h2>
    <div class="clueboard-doc-text">{{{ html }}}</div>
    {{#if revision}}
    <p class="clueboard-doc-revision">{{ revision }}</p>
    {{/if}}
</div>

<div class="clueboard-stamp">
    <div class="clueboard-stamp-cell">
        <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.stamp.foundIn" }}</span>
        {{#if stamp.foundAt}}<span>{{ stamp.foundAt }}</span>{{/if}}
        <small>{{ stamp.foundIn }}</small>
        {{#if stamp.calendarDate}}<small>{{ stamp.calendarDate }}</small>{{/if}}
        {{#if stamp.realDate}}<small>{{ stamp.realDate }}</small>{{/if}}
    </div>
    <div class="clueboard-stamp-cell">
        <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.stamp.readBy" }}</span>
        <span class="clueboard-chips">
            {{#each stamp.readers}}<span class="clueboard-chip{{#if me}} me{{/if}}">{{ name }}</span>{{else}}<span class="clueboard-chip none">{{ localize "fvtt-mod-clueboard.mysteries.nobody" }}</span>{{/each}}
        </span>
    </div>
    <div class="clueboard-stamp-cell">
        <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.stamp.kind" }}</span>
        <span>{{ kind }}</span>
    </div>
    {{#if stamp.notes}}
    <div class="clueboard-stamp-cell clueboard-stamp-notes">
        <span class="clueboard-stamp-key">{{ localize "fvtt-mod-clueboard.stamp.notesLabel" }}</span>
        <span class="clueboard-notes">{{ stamp.notes }}</span>
    </div>
    {{/if}}
</div>

<footer class="clueboard-reader-footer">
    <span class="clueboard-reader-hint">
        {{#if gmSilent}}{{ localize "fvtt-mod-clueboard.read.gmRead" }}{{/if}}
    </span>
    {{#if canNote}}
    <button type="button" data-action="note"><i class="fa-solid fa-pen" inert></i> {{ localize "fvtt-mod-clueboard.read.note" }}</button>
    {{/if}}
    {{#if canOpenItem}}
    <button type="button" data-action="openItem"><i class="fa-solid fa-arrow-up-right-from-square" inert></i> {{ localize "fvtt-mod-clueboard.read.openItem" }}</button>
    {{/if}}
</footer>
{{/if}}
</div>
