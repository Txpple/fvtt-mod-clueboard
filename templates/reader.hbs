<div class="clueboard-reader-body">
{{#if gone}}
<p class="clueboard-empty">{{ localize "fvtt-mod-clueboard.read.entryGone" }}</p>
{{else}}
<div class="clueboard-doc">
    <h2 class="clueboard-doc-title" dir="auto">{{ name }}</h2>
    {{#if img}}
    <figure class="clueboard-doc-figure"><img class="clueboard-doc-image" src="{{ img }}" alt="{{ name }}"></figure>
    {{/if}}
    <div class="clueboard-doc-text">{{{ html }}}</div>
    {{#if revision}}
    <p class="clueboard-doc-revision">{{ revision }}</p>
    {{/if}}

    <div class="clueboard-stamp">
        <div class="clueboard-field">
            <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.stamp.kind" }}</span>
            <span>{{ stamp.kind }}</span>
        </div>
        <div class="clueboard-field">
            <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.stamp.foundIn" }}</span>
            {{#if stamp.foundAt}}<span>{{ stamp.foundAt }}</span>{{/if}}
            {{#if stamp.when}}<span class="clueboard-note">{{ stamp.when }}</span>{{/if}}
        </div>
        <div class="clueboard-field">
            <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.stamp.readBy" }}</span>
            <span class="clueboard-chips">
                {{#each stamp.readers}}<span class="clueboard-chip{{#if me}} me{{/if}}">{{ name }}</span>{{else}}<span class="clueboard-note">{{ localize "fvtt-mod-clueboard.mysteries.nobody" }}</span>{{/each}}
            </span>
        </div>
        <div class="clueboard-field">
            <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.stamp.mysteries" }}</span>
            <span class="clueboard-chips">
                {{#each stamp.threads}}<span class="clueboard-chip clueboard-thread-{{ colour }}{{#if answered}} answered{{/if}}"><span class="clueboard-dot"></span>{{ name }}</span>{{else}}<span class="clueboard-note">{{ localize "fvtt-mod-clueboard.stamp.noMysteries" }}</span>{{/each}}
            </span>
        </div>
        <div class="clueboard-field">
            <span class="clueboard-key">{{ localize "fvtt-mod-clueboard.stamp.notesLabel" }}</span>
            {{#if stamp.notes}}<span class="clueboard-notes">{{ stamp.notes }}</span>{{else}}<span class="clueboard-note">{{ localize "fvtt-mod-clueboard.stamp.noNote" }}</span>{{/if}}
        </div>
    </div>
</div>

<footer class="clueboard-reader-footer">
    <span class="clueboard-reader-hint">
        {{#if gmSilent}}{{ localize "fvtt-mod-clueboard.read.gmRead" }}{{/if}}
    </span>
    {{#if canNote}}
    <button type="button" class="clueboard-btn" data-action="note"><i class="fa-solid fa-pen" inert></i> {{ localize "fvtt-mod-clueboard.read.note" }}</button>
    {{/if}}
    {{#if canOpenItem}}
    <button type="button" class="clueboard-btn" data-action="openItem"><i class="fa-solid fa-arrow-up-right-from-square" inert></i> {{ localize "fvtt-mod-clueboard.read.openItem" }}</button>
    {{/if}}
</footer>
{{/if}}
</div>
